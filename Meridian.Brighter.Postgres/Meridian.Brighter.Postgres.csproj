<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Meridian.Brighter.Postgres</RootNamespace>
        <PackageId>Meridian.Brighter.Postgres</PackageId>
        <Version>0.1.0</Version>
        <Authors>Max Anstey</Authors>
        <Description>Fixes and additions for running Paramore Brighter on PostgreSQL: a distributed lock that works across replicas, an outbox sweeper that survives failed sweeps, dead-letter re-drive and retention per message type, and inbox cleanup.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/maxanstey-meridian/meridian-brighter-postgres</PackageProjectUrl>
        <RepositoryUrl>https://github.com/maxanstey-meridian/meridian-brighter-postgres</RepositoryUrl>
        <PackageTags>dotnet;brighter;outbox;postgresql;distributed-lock</PackageTags>
        <IsPackable>true</IsPackable>
        <!-- Public API drift (RS0016 undeclared, RS0017 removed) fails the build. -->
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Paramore.Brighter" />
        <PackageReference Include="Paramore.Brighter.Extensions.DependencyInjection" />
        <PackageReference Include="Paramore.Brighter.MessagingGateway.Postgres" />
        <PackageReference Include="DistributedLock.Postgres" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
